{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: [
    "config:recommended",
    // Dependabot 時代のコミット/PR タイトル(chore(deps): ...)を踏襲する
    ":semanticCommitTypeAll(chore)",
  ],
  timezone: "Asia/Tokyo",
  // 起票のスケジュールは設けない。patch / minor は自動マージなので、
  // 窓を設けると「CI が通ったら即マージ」が窓待ちで最大1日遅れる。
  // 起票量は config:recommended の prHourlyLimit: 2 / prConcurrentLimit: 10 が抑える
  labels: ["dependencies"],
  // package.json のレンジ自体も上げる(Dependabot と同じ見え方にする)。
  // "auto" だとレンジ内更新が lockfile だけになり差分が読みにくい
  rangeStrategy: "bump",
  // GitHub ネイティブの auto-merge は使わない。
  // ruleset の必須チェックを Renovate が bypass できてしまう構成のため、
  // Renovate 自身に「ブランチのチェックが全て green」を確認させてからマージする
  platformAutomerge: false,
  lockFileMaintenance: {
    enabled: true,
    schedule: ["before 6am on monday"],
  },
  packageRules: [
    {
      // patch / minor / digest は CI(lint + astro check + build)が通れば自動マージ
      matchUpdateTypes: ["minor", "patch", "pin", "digest"],
      automerge: true,
    },
    {
      // major は破壊的変更を含みうるので必ず人がレビューする
      matchUpdateTypes: ["major"],
      automerge: false,
      addLabels: ["major"],
    },
    // Node / pnpm のバージョンは mise.toml・package.json の engines と
    // packageManager・各ワークフローの node-version と pnpm version に
    // 分散している。1つの PR にまとめて全箇所を同時に上げないとドリフトする。
    // Renovate の既定でも同じグルーピングになるが、崩れると片肺更新に
    // なってしまう箇所なので明示しておく
    {
      matchDepNames: ["node"],
      groupName: "Node.js",
    },
    {
      matchDepNames: ["pnpm"],
      groupName: "pnpm",
    },
  ],
  "github-actions": { enabled: true },
}
