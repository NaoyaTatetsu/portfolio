---
import { getCollection, render } from "astro:content";
import { isLocale } from "../../../i18n/ui";
import Base from "../../../layouts/Base.astro";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  // id は "en/2025/20250901" の形。ロケールと slug を取り出してルートを作る
  return posts.map((post) => {
    const segments = post.id.split("/");
    return {
      params: { locale: segments[0], slug: segments[segments.length - 1] },
      props: { post },
    };
  });
}

const { locale } = Astro.params;
const { post } = Astro.props;
if (!isLocale(locale)) return Astro.rewrite("/404");
const { Content } = await render(post);
---

<Base locale={locale} title={`${post.data.title} | Tatetsu Portfolio`}>
  <div class="w-full px-4 self-start pt-16">
    <div class="max-w-7xl mx-auto">
      <div class="flex flex-col items-center">
        <article class="mb-8 w-full max-w-3xl">
          <h1 class="text-xl font-bold mb-4">{post.data.title}</h1>
          <div
            class="text-sm mb-6 pb-6 border-b border-zinc-200 dark:border-zinc-800"
          >
            {post.data.date}
          </div>
          <div
            class="prose prose-zinc dark:prose-invert max-w-none prose-pre:bg-[#ebedf1] prose-pre:text-[#3d4450] dark:prose-pre:bg-[#2d3444] dark:prose-pre:text-[#cdd3de]"
          >
            <Content />
          </div>
        </article>
      </div>
    </div>
  </div>
</Base>
