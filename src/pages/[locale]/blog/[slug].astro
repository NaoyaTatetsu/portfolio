---
import { getCollection, render } from "astro:content";
import { isLocale } from "../../../i18n/ui";
import Base from "../../../layouts/Base.astro";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  // id は "en/2025/20250901" の形。ロケールと slug を取り出してルートを作る
  return posts.map((post) => {
    const segments = post.id.split("/");
    return {
      params: { locale: segments[0], slug: segments[segments.length - 1] },
      props: { post },
    };
  });
}

const { locale } = Astro.params;
const { post } = Astro.props;
if (!isLocale(locale)) return Astro.rewrite("/404");
const { Content } = await render(post);
---

<Base locale={locale} title={`${post.data.title} | Tatetsu Portfolio`}>
  <div class="w-full px-4 self-start pt-16">
    <div class="max-w-7xl mx-auto">
      <div class="flex flex-col items-center">
        <article class="mb-8 w-full max-w-3xl">
          <h1 class="text-2xl md:text-[33px] font-bold mb-4">{post.data.title}</h1>
          <div
            class="text-sm mb-6 pb-6 border-b border-zinc-200 dark:border-zinc-800"
          >
            {post.data.date}
          </div>
          <div
            class="prose prose-zinc dark:prose-invert max-w-none text-[16px] leading-[1.9] prose-h1:text-[1.7em] prose-h2:text-[1.5em] prose-h3:text-[1.3em] prose-h4:text-[1.1em] max-[576px]:prose-h1:text-[1.6em] max-[576px]:prose-h2:text-[1.4em] max-[576px]:prose-h3:text-[1.2em] prose-code:text-[0.85em] prose-code:before:content-none prose-code:after:content-none [&_.expressive-code]:my-[20.8px]"
          >
            <Content />
          </div>
        </article>
      </div>
    </div>
  </div>
</Base>
