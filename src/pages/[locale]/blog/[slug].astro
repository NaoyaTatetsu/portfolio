---
import { getCollection, render } from "astro:content";
import TableOfContents from "../../../components/TableOfContents.astro";
import { getMessages, isLocale } from "../../../i18n/ui";
import Base from "../../../layouts/Base.astro";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  // id は "en/2025/20250901" の形。ロケールと slug を取り出してルートを作る
  const slugOf = (id: string) => id.split("/").at(-1);
  return posts.map((post) => {
    const segments = post.id.split("/");
    const slug = slugOf(post.id);
    // 同じ slug の記事があるロケールだけを hreflang に出す（片方の言語しかない記事もありうる）
    const alternateLocales = posts
      .filter((other) => slugOf(other.id) === slug)
      .map((other) => other.id.split("/")[0])
      .filter(isLocale);
    return {
      params: { locale: segments[0], slug },
      props: { post, alternateLocales },
    };
  });
}

const { locale } = Astro.params;
const { post, alternateLocales } = Astro.props;
if (!isLocale(locale)) return Astro.rewrite("/404");
const { Content, headings } = await render(post);
const t = getMessages(locale).pages;
---

<Base
  locale={locale}
  title={post.data.title}
  alternateLocales={alternateLocales}
>
  <div class="w-full px-4 self-start pt-16">
    <div class="max-w-7xl mx-auto">
      {/* lg 以上は本文の右に目次を並べる。狭い画面では目次を出さない */}
      <div class="flex justify-center gap-10">
        <article class="mb-8 w-full max-w-3xl min-w-0">
          <h1 class="text-2xl md:text-[33px] font-bold mb-4">{post.data.title}</h1>
          <div
            class="text-sm mb-6 pb-6"
          >
            {post.data.date}
          </div>
          <div
            class="prose prose-zinc dark:prose-invert max-w-none text-[16px] leading-[1.9] prose-h1:text-[1.7em] prose-h2:text-[1.5em] prose-headings:scroll-mt-24 prose-h3:text-[1.3em] prose-h4:text-[1.1em] prose-h2:border-b-2 prose-h2:border-zinc-200 prose-h2:pb-2 dark:prose-h2:border-zinc-700 max-[576px]:prose-h1:text-[1.6em] max-[576px]:prose-h2:text-[1.4em] max-[576px]:prose-h3:text-[1.2em] prose-code:text-[0.85em] prose-code:before:content-none prose-code:after:content-none [&_.expressive-code]:my-[20.8px]"
          >
            <Content />
          </div>
        </article>
        <aside class="hidden w-60 shrink-0 lg:block">
          <TableOfContents headings={headings} label={t.toc} />
        </aside>
      </div>
    </div>
  </div>
</Base>
