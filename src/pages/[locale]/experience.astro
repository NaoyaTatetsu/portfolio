---
import { Icon } from "astro-icon/components";
import { getMessages, isLocale, localeParams } from "../../i18n/ui";
import Base from "../../layouts/Base.astro";

export function getStaticPaths() {
  return localeParams();
}

const { locale } = Astro.params;
if (!isLocale(locale)) return Astro.rewrite("/404");
const messages = getMessages(locale);
const t = messages.pages;
const items = messages.experience.items;

const timelineIcons: Record<string, string> = {
  company: "heroicons:building-office",
  school: "heroicons:academic-cap",
};
---

<Base locale={locale}>
  <div class="w-full px-4 pt-7 pb-20 self-start">
    <div class="max-w-7xl mx-auto">
      <div class="text-3xl mb-14 text-center font-bold">{t.experience}</div>
      <div class="flex flex-col items-center">
        {
          items.map((item) => (
            <div class="flex gap-4 w-full max-w-xl">
              <div class="flex flex-col items-center">
                <Icon
                  name={timelineIcons[item.icon] ?? "heroicons:building-office"}
                  class="w-5 h-5"
                />
                <div class="w-0.5 bg-gray-300 dark:bg-gray-700 flex-1" />
              </div>
              <div class="flex-1 mb-8 text-left">
                <div class="text-sm mb-2">{item.period}</div>
                <h3 class="text-xl font-semibold mb-2">{item.school}</h3>
                <div class="italic mb-2">{item.major}</div>
                {item.description && item.description.length > 0 && (
                  <ul class="list-disc list-inside space-y-1">
                    {item.description.map((desc) => (
                      <li class="text-sm">{desc}</li>
                    ))}
                  </ul>
                )}
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</Base>
