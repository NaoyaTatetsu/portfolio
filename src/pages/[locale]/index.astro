---
// このページは font-sans（Geist）を使うため、CSS の解析を待たずに
// フォントのダウンロードを始められるよう preload する（?url でハッシュ付き URL を解決）
import geistLatinWoff2 from "@fontsource-variable/geist/files/geist-latin-wght-normal.woff2?url";
import { Icon } from "astro-icon/components";
import Tilt from "../../components/Tilt.astro";
import TypingText from "../../components/TypingText.astro";
import { getMessages, isLocale, localeParams } from "../../i18n/ui";
import Base from "../../layouts/Base.astro";

export function getStaticPaths() {
  return localeParams();
}

const { locale } = Astro.params;
if (!isLocale(locale)) return Astro.rewrite("/404");
const t = getMessages(locale).home;

const bubbles = [
  {
    name: t.profile,
    href: `/${locale}/profile`,
    icon: "heroicons:user",
    external: false,
  },
  {
    name: t.blog,
    href: `/${locale}/blog`,
    icon: "heroicons:pencil-square",
    external: false,
  },
  {
    name: t.experience,
    href: `/${locale}/experience`,
    icon: "heroicons:building-office",
    external: false,
  },
  {
    name: t.contact,
    href: `/${locale}/contact`,
    icon: "heroicons:envelope",
    external: false,
  },
  {
    name: "X",
    href: "https://x.com/tttnaobi",
    icon: "fa6-brands:x-twitter",
    external: true,
  },
  {
    name: "Instagram",
    href: "https://www.instagram.com/tttnaoya?igsh=NG9jdTE1aG9zMDFp&utm_source=qr",
    icon: "fa6-brands:instagram",
    external: true,
  },
  {
    name: "GitHub",
    href: "https://github.com/NaoyaTatetsu",
    icon: "fa6-brands:github",
    external: true,
  },
];

// globals.css の orbit アニメーションの duration と合わせる
const orbitDuration = 120;

const bubbleClass =
  "orbit-bubble group pointer-events-auto absolute top-1/2 left-1/2 -mt-7 -ml-7 h-14 w-14";
---

<Base locale={locale}>
  <link
    slot="head"
    rel="preload"
    as="font"
    type="font/woff2"
    href={geistLatinWoff2}
    crossorigin
  />
  <div
    class="orbit-container relative flex w-full max-w-3xl flex-col items-center justify-center px-16 font-sans my-8"
  >
    <Tilt class="mb-8">
      <img
        src="/dev_icon.webp"
        alt="dev icon"
        width="352"
        height="353"
        fetchpriority="high"
        class="rounded-full w-32 h-32 md:w-44 md:h-44 lg:w-44 lg:h-44 shadow-lg dark:shadow-xl dark:shadow-zinc-800/50"
      />
    </Tilt>
    <TypingText />
    <nav class="absolute inset-0 pointer-events-none" aria-label="Main">
      {
        bubbles.map((bubble, index) => {
          const style = `--orbit-angle: ${(360 / bubbles.length) * index}deg; animation-delay: ${-(orbitDuration / bubbles.length) * index}s;`;
          const external = bubble.external
            ? { target: "_blank", rel: "noopener noreferrer" }
            : {};
          return (
            <a
              href={bubble.href}
              aria-label={bubble.name}
              class={bubbleClass}
              style={style}
              {...external}
            >
              {/* ホバー判定はリンク側の固定サイズで行い、見た目だけ拡大する（判定領域が動くと震えるため） */}
              <span class="flex h-full w-full items-center justify-center rounded-full border border-white/50 dark:border-white/20 bg-white/25 dark:bg-white/10 backdrop-blur-md shadow-[inset_0_4px_10px_rgba(255,255,255,0.45),0_4px_14px_rgba(0,0,0,0.15)] transition-transform duration-200 group-hover:scale-110">
                <Icon name={bubble.icon} class="w-6 h-6" />
              </span>
              <span class="pointer-events-none absolute top-full left-1/2 mt-2 -translate-x-1/2 whitespace-nowrap rounded-full border border-white/50 dark:border-white/20 bg-white/40 dark:bg-zinc-900/50 backdrop-blur-sm px-3 py-1 text-sm opacity-0 transition-opacity duration-200 group-hover:opacity-100">
                {bubble.name}
              </span>
            </a>
          );
        })
      }
    </nav>
  </div>
</Base>
