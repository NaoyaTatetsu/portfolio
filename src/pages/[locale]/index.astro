---
import Home from "../../components/Home.astro";
import { homeLocaleParams, isLocale } from "../../i18n/ui";

// 日本語のトップは / に出すので /ja は生成しない（/ja は _redirects で / へ）
export function getStaticPaths() {
  return homeLocaleParams();
}

const { locale } = Astro.params;
if (!isLocale(locale)) return Astro.rewrite("/404");
---

<Home locale={locale} />
