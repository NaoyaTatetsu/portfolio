---
import "@fontsource-variable/geist";
import "@fontsource-variable/geist-mono";
import "../styles/global.css";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import { getMessages, type Locale } from "../i18n/ui";

interface Props {
  locale: Locale;
  title?: string;
  /** メタディスクリプション。省略時はロケール別のサイト共通文言 */
  description?: string;
}

const {
  locale,
  title = "Tatetsu Portfolio",
  description = getMessages(locale).site.description,
} = Astro.props;

const favicon =
  "data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>🍭</text></svg>";
---

<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href={favicon} />
    <link rel="apple-touch-icon" href="/apple-touch-icon.svg" />
    {/*
      ページ固有の <head> 要素（フォントの preload など）の差し込み口。
      フォントは使うページだけが preload する（全ページ共通にすると
      未使用ページで無駄なダウンロードが発生するため）
    */}
    <slot name="head" />
    {/*
      初回ペイント前に同期実行してテーマクラスを確定させる。
      これが無いとダークモードで白フラッシュが出る。
      localStorage のキー "theme" は next-themes 時代と同じものを使うため、
      既存訪問者の設定はそのまま引き継がれる。
    */}
    <script is:inline>
      (() => {
        try {
          const stored = localStorage.getItem("theme");
          const theme = stored === "light" || stored === "dark" ? stored : "dark";
          document.documentElement.classList.add(theme);
        } catch {
          document.documentElement.classList.add("dark");
        }
      })();
    </script>
  </head>
  <body>
    <div class="min-h-screen flex flex-col">
      <Header locale={locale} />
      <main class="flex-1 flex items-center justify-center pt-16">
        <slot />
      </main>
      <Footer />
    </div>
  </body>
</html>
